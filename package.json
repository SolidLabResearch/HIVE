    "experiment:patterns-approx-vs-fetching": "npx ts-node scripts/run-patterns-approx-vs-fetching.ts",
    "test:orchestrator-lifecycle": "npx ts-node scripts/test-orchestrator-lifecycle.ts",
    "experiment:calculate-accuracy": "npx ts-node scripts/calculate-accuracy.ts",
    "data:generate-aligned": "npx ts-node scripts/generate-aligned-test-data.ts"
