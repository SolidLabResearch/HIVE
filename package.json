    "@typescript-eslint/parser": "^6.21.0",
    "esdoc": "^0.0.2",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^27.8.0",
    "eslint-plugin-jsdoc": "^48.0.6",
    "jest": "^29.3.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.3",
    "typescript": "^4.9.5"
  },
  "dependencies": {
