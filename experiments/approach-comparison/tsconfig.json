{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "../../dist/experiments/approach-comparison",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "*": ["node_modules/*", "src/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
